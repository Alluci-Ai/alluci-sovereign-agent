# .gitignore — PRODUCTION READINESS REVISION

# ── Dependency Management ─────────────────────────────────────────────────────
node_modules/
venv/
.venv/
env/
.env.local
.env.development.local
.env.test.local
.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Sensitive Material (URGENT) ────────────────────────────────────────────────
# Never commit certificates or private keys.
certs/
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
.polytope/
vault/
alluci_vault/
polytope_data.db
polytope_data.db-journal

# ── Build Artifacts ────────────────────────────────────────────────────────────
dist/
dist-ssr/
*.local
.eslintcache
.stylelintcache
.vite/
.next/
out/
build/
.pwa/
manifest.json

# ── Python / Backend ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage*
*_pid.txt
htmlcov/
.mypy_cache/
.ruff_cache/
backend.log
backend_pcl.log
backend_restart_hlsm.log
test_polytope.db
*.db
alembic_history.log

# ── OS / Editors ───────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
.project
.settings/
*.log

# ── Docker ────────────────────────────────────────────────────────────────────
.docker/
docker-compose.override.yml

# === Secrets & Runtime Artifacts (added by remediation) ===
.env
*.db-wal
*.db-shm
nohup.out
heartbeat_state.json
.hb_fw_*.json
*.dylib
*.o
*.so
build/

# DPK Native Kernel
backend/security/build/
*.so
*.dylib
*.dll

# Large Assets & Reports
models/
reports/

# Generated artifacts — never commit
coverage.xml
.coverage
typecheck_output.txt
backend_pid.txt
reports/coverage.xml

# detect-secrets baseline (regenerated by hook)
.secrets.baseline
alluci_vault/
backups/
