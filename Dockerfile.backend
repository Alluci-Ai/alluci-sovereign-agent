# ============================
# Backend Dockerfile
# Multi-stage build for the Polytope Executive Daemon
# ============================
FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install system dependencies required for building
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    g++ \
    make \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install Python dependencies
COPY requirements.txt .
RUN pip install --upgrade pip setuptools wheel && pip install --prefer-binary -r requirements.txt

# Copy backend code and compile native kernels
COPY backend/ ./backend/
RUN make -C backend/security/ all verify

# ============================
FROM python:3.12-slim AS production

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    PLAYWRIGHT_BROWSERS_PATH="/ms-playwright"

WORKDIR /app

# Copy virtualenv and compiled application code from builder
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /app/backend/ ./backend/
COPY HEARTBEAT.md ./

# We assume entrypoint.sh is added to backend/ in the repo
# Ensure it is executable
RUN chmod +x ./backend/entrypoint.sh

# Install playwright OS dependencies
RUN playwright install-deps chromium && \
    mkdir -p /ms-playwright && \
    chmod -R 777 /ms-playwright

# Create non-root user for security
RUN useradd -m -r appuser && \
    mkdir -p /home/appuser/.appuser/vaults && \
    chown -R appuser:appuser /app /home/appuser /ms-playwright

USER appuser

# Install Playwright browser binaries as the appuser
RUN playwright install chromium

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health')" || exit 1

EXPOSE 8000

CMD ["./backend/entrypoint.sh"]
