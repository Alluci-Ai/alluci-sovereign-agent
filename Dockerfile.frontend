# Dockerfile.frontend — EXPLICIT COPY ALLOWLIST REVISION

FROM node:20-alpine AS build
WORKDIR /app

# [ CACHE_L0 ]: Dependencies
COPY package.json package-lock.json* ./
RUN npm ci

# [ CACHE_L1 ]: Source Code (EXPLICIT ALLOWLIST)
# Only copy necessary files to prevent secret leakage into Docker layers.
COPY public/ ./public/
COPY src/ ./src/
COPY lib/ ./lib/
COPY kernel/ ./kernel/
COPY security/ ./security/
COPY features/ ./features/
COPY *.ts *.tsx *.json *.config.js *.config.ts ./

# [ BUILD_GATEWAY ]: Manifold Bundle
RUN npm run build

# [ RUNTIME_ISOLATION ]: NGINX Manifold
FROM nginx:stable-alpine
WORKDIR /usr/share/nginx/html

# Zero-copy transfer of build artifacts
COPY --from=build /app/dist .

# Production Hardened Ingress
COPY nginx.conf /etc/nginx/nginx.conf

# Security Headers (Applied via server block in nginx.conf)
# Add non-root user for security
RUN addgroup -g 1000 appuser && adduser -D -G appuser -u 1000 appuser && \
    chown -R appuser:appuser /usr/share/nginx/html && \
    chown -R appuser:appuser /var/cache/nginx && \
    chown -R appuser:appuser /var/log/nginx && \
    chown -R appuser:appuser /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chown -R appuser:appuser /var/run/nginx.pid

USER appuser

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD wget -qO- http://localhost:8080 > /dev/null || exit 1

EXPOSE 8080 8443
CMD ["nginx", "-g", "daemon off;"]
