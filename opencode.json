{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "alluci": {
      "name": "Alluci Sovereign MLX Engine",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1"
      }
    }
  },
  "model": "alluci/mlx-community/GLM-4-32B-0414-4bit",
  "server": {
    "port": 4096,
    "hostname": "127.0.0.1"
  },
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."],
      "enabled": true
    },
    "git": {
      "type": "local",
      "command": ["uvx", "mcp-server-git", "--repository", "."],
      "enabled": true
    },
    "sqlite": {
      "type": "local",
      "command": ["uvx", "mcp-server-sqlite", "--db-path", "./polytope_data.db"],
      "enabled": true
    },
    "ast-grep": {
      "type": "local",
      "command": ["npx", "-y", "@ast-grep/cli", "lsp"],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    }
  },
  "lsp": {
    "python": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    },
    "typescript": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"]
    },
    "rust": {
      "command": ["rust-analyzer"],
      "extensions": [".rs"]
    },
    "go": {
      "command": ["gopls"],
      "extensions": [".go"]
    },
    "clangd": {
      "command": ["clangd"],
      "extensions": [".c", ".cpp", ".cc", ".h", ".hpp"]
    },
    "bash": {
      "command": ["bash-language-server", "start"],
      "extensions": [".sh", ".bash", ".zsh"]
    },
    "yaml": {
      "command": ["yaml-language-server", "--stdio"],
      "extensions": [".yaml", ".yml"]
    },
    "json": {
      "command": ["vscode-json-language-server", "--stdio"],
      "extensions": [".json", ".jsonc"]
    }
  },
  "formatter": {
    "ruff": {
      "command": ["ruff", "format", "$FILE"],
      "extensions": [".py", ".pyi"]
    },
    "prettier": {
      "command": ["npx", "prettier", "--write", "$FILE"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".json", ".md", ".yaml", ".yml", ".css"]
    },
    "rustfmt": {
      "command": ["rustfmt", "$FILE"],
      "extensions": [".rs"]
    },
    "gofmt": {
      "command": ["gofmt", "-w", "$FILE"],
      "extensions": [".go"]
    }
  },
  "agent": {
    "codi": {
      "description": "Codi OpenCode Autonomous Software Engineering Subagent",
      "mode": "subagent",
      "color": "primary",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "allow",
        "lsp": "allow",
        "skill": "allow"
      }
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "lsp": "allow",
    "skill": "allow"
  },
  "instructions": [
    ".agents/skills/codi_opencode_harness/SKILL.md",
    ".opencode/skills/autonomous_software_engineering/SKILL.md",
    "ARCHITECTURE.md"
  ]
}
