# =============================================================================
# Alluci Sovereign Agent — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env

# ─── Security & Sovereignty ──────────────────────────────────────────────────
# Master encryption key for the Simplicial Vault (Fernet-compatible base64)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
POLYTOPE_MASTER_KEY=

# Separate key for JWT token signing (do NOT reuse the master key)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# ─── Model Providers ────────────────────────────────────────────────────────
# Required: Google Gemini API key
GEMINI_API_KEY=

# Optional: Failover inference providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Optional: VerusID Sovereign Identity ─────────────────────────────────────
# VERUS_ID_IDENTITY=alluci@
# VERUS_ID_PRIVATE_KEY=

# ─── Network ────────────────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
# ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ─── Rate Limiting ──────────────────────────────────────────────────────────
# RATE_LIMIT_PER_MINUTE=60

# ─── Database ───────────────────────────────────────────────────────────────
# DATABASE_URL=sqlite:///polytope_data.db

# Docker Compose database password (used by docker-compose.yml)
# IMPORTANT: Change this in production!
# DB_PASSWORD=sovereign

# ─── Execution Governance ────────────────────────────────────────────────────
# MAX_AUTONOMY_RETRIES=3
# CRITIC_THRESHOLD=0.75
# MAX_CONCURRENT_TASKS=5

# ─── Deployment ─────────────────────────────────────────────────────────────
# APP_ENV=development  # development | production | local_sovereign

# ─── WebAuthn / Passkeys ────────────────────────────────────────────────────
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:5173

# ─── Redis (Cache & Rate Limiting) ──────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=

# ─── Production Database ────────────────────────────────────────────────────
# Required when APP_ENV=production (SQLite is rejected in production)
# PROD_DATABASE_URL=postgresql+asyncpg://alluci:password@localhost/polytope

# ─── Local Sovereign Inference Stack ─────────────────────────────────────────
# Install with: bash scripts/setup_sovereign_stack.sh
# OLLAMA_URL=http://localhost:11434
# WHISPER_CPP_PATH=whisper-cpp
# PIPER_PATH=piper
# PIPER_MODEL=en_US-amy-medium.onnx
