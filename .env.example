# =============================================================================
# ALLUCI SOVEREIGN AGENT — Complete Environment Configuration
# Version: 3.3  |  Updated: 2026-03-15
# =============================================================================
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# REQUIRED keys (app will not start without these):
#   POLYTOPE_MASTER_KEY, JWT_SECRET_KEY
#
# At least one LLM provider key is required for the agent to function.
# All bridge/channel keys are optional — configure only the bridges you use.
# =============================================================================

# ── REQUIRED: Security & Sovereignty ──────────────────────────────────────────
# SECRETS NEVER LEAVE HARDWARE:
# Critical keys are stored in your OS Keychain (macOS, GNOME Keyring, Windows CM).
# On first boot, run:  python3 scripts/provision_vault.py
#
# After provisioning, these keys can be removed from this file.
# They will be loaded from your hardware automatically.

# Master encryption key for the Simplicial Vault (AES-256-GCM).
POLYTOPE_MASTER_KEY=

# ── LOCAL INFERENCE ───────────────────────────────────────────────────────────
# Ollama is the PRIMARY inference provider. Install from https://ollama.ai
# The agent automatically selects the model based on available RAM:
#   < 2 GB  →  tinyllama:1.1b
#   2–6 GB  →  phi3:mini
#   6–16 GB →  mistral:7b-instruct-v0.3-q4_K_M
#   16 GB+  →  llama3.3:70b  (for HIGH-complexity requests only)
#
OLLAMA_URL=http://localhost:11434
# Override the RAM-aware model selection:
# OLLAMA_MODEL_STRONG=llama3.3:70b
# OLLAMA_MODEL_MEDIUM=mistral:7b-instruct-v0.3-q4_K_M
# OLLAMA_MODEL_LIGHT=phi3:mini
# OLLAMA_MODEL_LITE=tinyllama:1.1b
# OLLAMA_TIMEOUT_SECONDS=120
# GPU layers to offload (0 = CPU only, 35 = typical full offload):
# OLLAMA_NUM_GPU=35

# LM Studio — local fallback if Ollama is not running
LM_STUDIO_URL=http://localhost:1234/v1
# Model identifier shown in LM Studio (e.g. "llama-3.2-3b-instruct"):
LM_STUDIO_MODEL=local-model

# ── HUGGINGFACE (optional) ────────────────────────────────────────────────────
# Set to use HuggingFace Inference API as a third local-ish option.
# Your HF token stays on your machine (stored in OS keychain via provisioner).
# HUGGINGFACE_API_TOKEN=
# HUGGINGFACE_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.3
# HUGGINGFACE_ENDPOINT_URL=

# ── SOVEREIGN MODE ────────────────────────────────────────────────────────────
# Set to true to disable ALL cloud providers.
# Only Ollama, LM Studio, and HuggingFace will be used.
# SOVEREIGN_MODE=false

# Separate signing key for JWT tokens.
JWT_SECRET_KEY=

# Separate signing key for CSRF tokens.
CSRF_SECRET_KEY=

# ── APPLICATION ───────────────────────────────────────────────────────────────
APP_ENV=development
# Options: development | production | local_sovereign
# NOTE: production mode:
#   - Rejects SQLite (PROD_DATABASE_URL required)
#   - Strips localhost from ALLOWED_ORIGINS
#   - Enforces HTTPS-only cookies

HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
# Production example:
# ALLOWED_ORIGINS=https://app.yourdomain.com

# ── DATABASE ──────────────────────────────────────────────────────────────────
# Development default (SQLite):
DATABASE_URL=sqlite:///polytope_data.db

# Production (required when APP_ENV=production — SQLite is rejected):
# PROD_DATABASE_URL=postgresql+asyncpg://alluci:yourpassword@localhost:5432/alluci_db

# ── CACHE (Redis) ─────────────────────────────────────────────────────────────
# Optional but strongly recommended. Enables:
#   - Distributed rate limiting
#   - Redis-backed OAuth PKCE state
#   - Redis-backed WebAuthn challenge store
#   - VerusID challenge persistence across restarts
# Without Redis: all of the above fall back to in-memory (lost on restart).
# REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=

# ── LLM PROVIDERS ─────────────────────────────────────────────────────────────
# At least one key is required. Failover chain: Gemini→OpenAI→Anthropic→...
# Leave blank to skip a provider.

# Primary (Gemini 2.0 Flash / 2.5 Pro)
GEMINI_API_KEY=

# Default model reported in signed execution manifests.
# Should match the primary inference model configured in AGENT.md.
# Options: gemini-2.0-flash | gemini-2.5-pro-preview-05-06 | gpt-4o | claude-3-7-sonnet-20250219
VITE_DEFAULT_MODEL=gemini-2.0-flash

# Failover 1 — OpenAI GPT-4o / GPT-4o-mini
OPENAI_API_KEY=

# Failover 2 — Anthropic Claude 3.7 Sonnet / Haiku
ANTHROPIC_API_KEY=

# Failover 3 — Groq LPU (sub-100ms tactical routing)
GROQ_API_KEY=

# Failover 4 — DeepSeek R1 (reasoning tasks)
DEEPSEEK_API_KEY=

# Failover 5 — OpenRouter (100+ models via single key)
OPENROUTER_API_KEY=

# Failover 6 — NVIDIA NIM / Kimi k2.5 (reasoning with thinking)
NVIDIA_NIM_API_KEY=

# Failover 7 — Together AI (open-source models)
TOGETHER_API_KEY=

# Failover 8 — Cohere Command R+
COHERE_API_KEY=

# Local inference (no key required — requires binaries installed locally)
LM_STUDIO_URL=http://localhost:1234/v1
OLLAMA_URL=http://localhost:11434

# AWS (Optional — used only for Bedrock inference if manually enabled)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ── WEBAUTHN / PASSKEYS ───────────────────────────────────────────────────────
# The RP ID must match your domain (hostname only, no protocol or port).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
# Production:
# WEBAUTHN_RP_ID=app.yourdomain.com
# WEBAUTHN_ORIGIN=https://app.yourdomain.com

AUTH_COOKIE_NAME=alluci_daemon_token
AUTH_COOKIE_SAMESITE=lax
# Production: set to 'strict'

# ── GOOGLE (Gmail + Google Drive + Google Chat) ───────────────────────────────
# Single OAuth app covers Gmail, GDrive, and Google Chat.
# Create at: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Add to your OAuth app's Authorized redirect URIs:
# http://localhost:8000/api/v1/oauth/gmail/callback
# http://localhost:8000/api/v1/oauth/gdrive/callback

GOOGLE_CHAT_SERVICE_ACCOUNT_FILE=
GOOGLE_CHAT_AUDIENCE=

# ── SLACK ─────────────────────────────────────────────────────────────────────
# Create app at: api.slack.com/apps
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_VERIFICATION_TOKEN=
SLACK_REDIRECT_URI=http://localhost:8000/api/v1/oauth/slack/callback
# Add to Slack app Event Subscriptions URL:
# http://yourdomain/api/v1/webhook/slack

# ── DISCORD ───────────────────────────────────────────────────────────────────
# Create app at: discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── TELEGRAM ─────────────────────────────────────────────────────────────────
# Get bot token from @BotFather. Store via Channels UI → saved to vault.
# No env var needed — token is stored in encrypted vault at connection time.

# ── WHATSAPP CLOUD API ────────────────────────────────────────────────────────
# Setup at: developers.facebook.com → WhatsApp → Getting Started
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Set WHATSAPP_VERIFY_TOKEN to any string you choose — must match your webhook config
WHATSAPP_VERIFY_TOKEN=alluci_whatsapp_verify
WHATSAPP_APP_SECRET=
WHATSAPP_CLIENT_ID=
WHATSAPP_CLIENT_SECRET=

# ── META (Facebook Messenger + Instagram) ─────────────────────────────────────
# Single Meta app covers both Facebook Pages and Instagram Business accounts.
# Setup at: developers.facebook.com
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# META_APP_SECRET is the App Secret from your Meta app dashboard
META_APP_SECRET=
# Set META_VERIFY_TOKEN to any string — must match your webhook configuration
META_VERIFY_TOKEN=alluci_meta_verify

# ── X / TWITTER ───────────────────────────────────────────────────────────────
# Create app at: developer.twitter.com — requires OAuth 2.0 + PKCE
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ── MICROSOFT TEAMS ───────────────────────────────────────────────────────────
# Register app in Azure AD: portal.azure.com → App registrations
MSTEAMS_CLIENT_ID=
MSTEAMS_CLIENT_SECRET=
MSTEAMS_BOT_APP_ID=

# ── WECOM (Enterprise WeChat / 企业微信) ────────────────────────────────────────
# Register at: work.weixin.qq.com → 应用管理 (Application Management)
WECOM_CORP_ID=
WECOM_CORP_SECRET=
WECOM_AGENT_ID=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=

# ── SIGNAL ────────────────────────────────────────────────────────────────────
# Requires signal-cli installed: https://github.com/AsamK/signal-cli
SIGNAL_CLI_PATH=signal-cli
SIGNAL_SOCKET_PATH=/tmp/signal-cli.sock
# Register your number first: signal-cli -u +1234567890 register

# ── ICLOUD ────────────────────────────────────────────────────────────────────
# Credentials stored via Channels UI → vault. No env var needed for Apple ID.
ICLOUD_COOKIE_DIR=~/.icloud

# ── VERUS IDENTITY (optional sovereign identity layer) ───────────────────────
VERUS_AUTH_ENABLED=false
VERUS_ID_IDENTITY=
# WIF-encoded private key for signing audit events
VERUS_ID_PRIVATE_KEY=
VERUS_RPC_HOST=127.0.0.1
VERUS_RPC_PORT=27486
VERUS_RPC_USER=
VERUS_RPC_PASSWORD=
VERUS_WALLET_ENABLED=true
VERUS_LITE_MODE=true
VERUS_NETWORK=mainnet
# VERUS_STAKING_ADDRESS=
# VERUS_DEFAULT_CURRENCY=VRSC

# ── LOCAL INFERENCE STACK ─────────────────────────────────────────────────────
# Install with: bash scripts/setup_sovereign_stack.sh
# Or individually:
#   - Whisper.cpp: github.com/ggerganov/whisper.cpp
#   - Piper TTS: github.com/rhasspy/piper
#   - Ollama: ollama.ai
WHISPER_CPP_PATH=whisper-cpp
PIPER_PATH=piper
PIPER_MODEL=en_US-amy-medium.onnx

# ── EXECUTION GOVERNANCE ──────────────────────────────────────────────────────
MAX_AUTONOMY_RETRIES=3
CRITIC_THRESHOLD=0.75
MAX_CONCURRENT_TASKS=5
RATE_LIMIT_PER_MINUTE=60

# ── PROACTIVE COGNITION LOOP (PCL) ───────────────────────────────────────────
# persistent background loop for proactive intelligence
PCL_ENABLED=true
# How often to run the cycle (in seconds). Default: 300 (5 minutes)
PCL_CYCLE_INTERVAL=300
# Hours (UTC) during which non-critical PCL actions are suppressed
PCL_QUIET_START_HOUR=22
PCL_QUIET_END_HOUR=7

# ── PLATFORM ──────────────────────────────────────────────────────────────────
# LITE_MODE auto-detected as true when system RAM < 2.5GB (e.g., Raspberry Pi).
# Set explicitly to override auto-detection.
# LITE_MODE=false

# URL of this daemon — used for watchOS pairing QR code generation.
DAEMON_PUBLIC_URL=http://localhost:8000

# ── DEPLOYMENT (production only) ─────────────────────────────────────────────
# Required when APP_ENV=production:
# PROD_DATABASE_URL=postgresql+asyncpg://alluci:yourpassword@db:5432/alluci_db
# Docker Compose Postgres password:
# DB_PASSWORD=change_this_in_production
