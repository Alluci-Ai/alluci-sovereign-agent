# =============================================================================
# Alluci Sovereign Agent — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env. It is listed in .gitignore.
# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Generate Fernet key with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# =============================================================================

# --- Core Cryptographic Keys ---
POLYTOPE_MASTER_KEY=REPLACE_WITH_FERNET_KEY
JWT_SECRET_KEY=REPLACE_WITH_TOKEN_URLSAFE_64
CSRF_SECRET_KEY=REPLACE_WITH_TOKEN_URLSAFE_64

# --- Database ---
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DATABASE_URL=postgresql://alluci:${DB_PASSWORD}@db:5432/alluci

# --- Redis ---
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# --- Meta / Instagram ---
META_APP_SECRET=REPLACE_WITH_META_APP_SECRET
INSTAGRAM_CLIENT_SECRET=REPLACE_WITH_INSTAGRAM_CLIENT_SECRET

# --- Twitter / X ---
TWITTER_CLIENT_SECRET=REPLACE_WITH_TWITTER_CLIENT_SECRET

# --- Microsoft Teams ---
MSTEAMS_CLIENT_SECRET=REPLACE_WITH_AZURE_CLIENT_SECRET
BOT_APP_ID=REPLACE_WITH_AZURE_BOT_APP_ID

# --- Frontend ---
# Use the correct model ID. gemini-3.0-flash does NOT exist.
VITE_DEFAULT_MODEL=gemini-2.0-flash

# --- OpenTelemetry (optional) ---
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Feature Flags ---
UNOFFICIAL_BRIDGES_ENABLED=false
